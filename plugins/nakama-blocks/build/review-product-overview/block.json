{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/product-review",
  "version": "0.1.0",
  "title": "Product Review",
  "category": "widgets",
  "icon": "cart",
  "description": "Displays a product review with key info, rating, and highlights.",
  "example": {},
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Product Review"
    },
    "manufacturer": {
      "type": "string",
      "default": "Manufacturer name"
    },
    "price": {
      "type": "string",
      "default": "Price"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "items": {
      "type": "array",
      "default": [
        {
          "heading": "",
          "description": ""
        }
      ],
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "bulletHeading": {
      "type": "string",
      "default": "Pros"
    },
    "bullets": {
      "type": "array",
      "default": []
    },
    "consHeading": {
      "type": "string",
      "default": "Cons"
    },
    "cons": {
      "type": "array",
      "default": []
    },
    "cta": {
      "type": "object",
      "default": {
        "text": "",
        "url": ""
      },
      "properties": {
        "text": {
          "type": "string",
          "default": ""
        },
        "url": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "product-review",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}